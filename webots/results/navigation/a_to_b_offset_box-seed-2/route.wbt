#VRML_SIM R2025a utf8
EXTERNPROTO "../protos/RaptorCrazyflie.proto"
WorldInfo {
  title "RAPTOR A-to-B Offset Box"
  basicTimeStep 1
  gravity 9.81
  coordinateSystem "ENU"
  physicsDisableTime -1
}
Viewpoint {
  orientation 0.32 0.78 0.53 1.15
  position 5.8 -7.2 5.0
  follow "RaptorCrazyflie"
}
Background { skyColor [ 0.62 0.77 0.92 ] }
DirectionalLight { direction -0.4 -0.3 -1 intensity 0.85 }
Solid {
  translation 2 0 -0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.72 0.74 0.76 roughness 1 } geometry Box { size 18 12 0.1 } } ]
  boundingObject Box { size 18 12 0.1 }
  locked TRUE
}
# A real ODE box leaves more than one vehicle-width of clearance on each side.
Solid {
  translation 2.0 0.50164 1.5
  children [ Shape { appearance PBRAppearance { baseColor 0.76 0.42 0.20 roughness 1 } geometry Box { size 0.6 1.2 1.8 } } ]
  boundingObject Box { size 0.6 1.2 1.8 }
  locked TRUE
}
RaptorCrazyflie {
  translation 0 0 1.5
  name "RaptorCrazyflie"
  controller "raptor_webots"
  supervisor TRUE
  customData "phase=navigation;seed=2;policy=../assets/navigation.bin;speed=1.5;distance=4;goal=4,0,1.5;max_steps=800;profile=hover;motor_sampling=average"
}
