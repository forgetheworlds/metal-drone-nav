#VRML_SIM R2025a utf8
EXTERNPROTO "../protos/RaptorCrazyflie.proto"
WorldInfo { title "RAPTOR RangeFinder Plane Calibration" basicTimeStep 10 gravity 9.81 coordinateSystem "ENU" }
Viewpoint { orientation 0 0 1 0 position 0 0 5 }
Background { skyColor [ 0.62 0.77 0.92 ] }
DirectionalLight { direction -0.4 -0.3 -1 intensity 0.85 }
Solid {
  name "Ground"
  translation 0 0 -0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.72 0.74 0.76 } geometry Box { size 8 8 0.1 } } ]
  boundingObject Box { size 8 8 0.1 }
  locked TRUE
}
Solid {
  name "FrontPlane"
  translation 2.0 0 1.5
  children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Box { size 0.1 8 6 } } ]
  boundingObject Box { size 0.1 8 6 }
  locked TRUE
}
Solid { name "RearPlane" translation -3 0 1.5 children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Box { size 0.1 8 6 } } ] boundingObject Box { size 0.1 8 6 } locked TRUE }
Solid { name "LeftPlane" translation 0 2.5 1.5 children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Box { size 8 0.1 6 } } ] boundingObject Box { size 8 0.1 6 } locked TRUE }
Solid { name "RightPlane" translation 0 -4 1.5 children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Box { size 8 0.1 6 } } ] boundingObject Box { size 8 0.1 6 } locked TRUE }
Solid { name "Ceiling" translation 0 0 4 children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Box { size 8 8 0.1 } } ] boundingObject Box { size 8 8 0.1 } locked TRUE }
Solid { name "LeftUpMarker" translation 1.5 0.8 2.1 children [ Shape { appearance PBRAppearance { baseColor 0.9 0.1 0.1 } geometry Box { size 0.2 0.4 0.4 } } ] boundingObject Box { size 0.2 0.4 0.4 } locked TRUE }
Solid { name "RightDownMarker" translation 1.5 -0.8 0.9 children [ Shape { appearance PBRAppearance { baseColor 0.1 0.1 0.9 } geometry Box { size 0.2 0.4 0.4 } } ] boundingObject Box { size 0.2 0.4 0.4 } locked TRUE }
RaptorCrazyflie {
  translation 0 0 1.5
  name "RaptorCrazyflie"
  controller "raptor_webots"
  supervisor TRUE
  customData "phase=range-calibrate;seed=0;policy=../assets/navigation.bin;speed=1.5;distance=4;goal=4,0,1.5;max_steps=6"
}
