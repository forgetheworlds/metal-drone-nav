#VRML_SIM R2025a utf8
EXTERNPROTO "../protos/RaptorCrazyflie.proto"
WorldInfo { title "RAPTOR RangeFinder Far Plane Calibration" basicTimeStep 10 gravity 9.81 coordinateSystem "ENU" }
Viewpoint { orientation 0 0 1 0 position 0 0 5 }
Background { skyColor [ 0.62 0.77 0.92 ] }
DirectionalLight { direction -0.4 -0.3 -1 intensity 0.85 }
Solid { name "Ground" translation 0 0 -0.05 children [ Shape { appearance PBRAppearance { baseColor 0.72 0.74 0.76 } geometry Box { size 8 8 0.1 } } ] boundingObject Box { size 8 8 0.1 } locked TRUE }
Solid { name "FrontPlane" translation 3.0 0 1.5 children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.5 } geometry Box { size 0.1 8 6 } } ] boundingObject Box { size 0.1 8 6 } locked TRUE }
RaptorCrazyflie {
  translation 0 0 1.5
  name "RaptorCrazyflie"
  controller "raptor_webots"
  supervisor TRUE
  customData "phase=range-calibrate;seed=0;policy=../assets/navigation.bin;speed=1.5;distance=4;goal=4,0,1.5;range_plane_x=3;max_steps=6"
}
