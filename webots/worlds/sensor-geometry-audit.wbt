#VRML_SIM R2025a utf8
# Independent sensor-geometry audit fixture. Owner: results/omp-sensor-transfer.
# Static calibration rig only: not a flight world, not a RAPTOR/navigation result.
# The RangeFinder copies the production mount (translation 0.08 0 0, 20x16, fov 90 deg,
# near/minRange 0.03, maxRange 12, resolution 0.001). Scene primitives are frozen and hashed.
WorldInfo {
  title "Sensor geometry audit (independent calibration rig)"
  basicTimeStep 10
  coordinateSystem "ENU"
  gravity 0
}
Viewpoint {
  orientation 0 0 1 0
  position -2.5 -3.5 2.6
}
Background {
  skyColor [ 0.05 0.06 0.10 ]
}
DEF RIG Robot {
  name "SensorCalibration"
  controller "sensor_geometry_audit"
  controllerArgs []
  customData "out=../results/omp-sensor-transfer/sensor-geometry/native-frames.jsonl"
  supervisor TRUE
  translation 0 0 1.5
  rotation 0 0 1 0
  children [
    GPS { name "gps" }
    InertialUnit { name "imu" }
    Gyro { name "gyro" }
    RangeFinder {
      name "depth"
      translation 0.08 0 0
      rotation 0 0 1 0
      projection "planar"
      fieldOfView 1.570796327
      width 20
      height 16
      near 0.03
      minRange 0.03
      maxRange 12
      noise 0
      resolution 0.001
    }
  ]
}
DEF GROUND Solid {
  translation 0 0 -0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.55 0.55 0.58 } geometry Box { size 40 40 0.1 } } ]
  locked TRUE
}
DEF CEILING Solid {
  translation 0 0 5.05
  children [ Shape { appearance PBRAppearance { baseColor 0.5 0.5 0.52 } geometry Box { size 40 40 0.1 } } ]
  locked TRUE
}
DEF FRONT_WALL Solid {
  translation 3.05 0 1.3
  children [ Shape { appearance PBRAppearance { baseColor 0.6 0.6 0.6 } geometry Box { size 0.1 3 2.6 } } ]
  locked TRUE
}
DEF BACK_WALL Solid {
  translation -3.05 0 2.5
  children [ Shape { appearance PBRAppearance { baseColor 0.6 0.6 0.6 } geometry Box { size 0.1 16 5 } } ]
  locked TRUE
}
DEF LEFT_WALL Solid {
  translation 0 3.05 2.5
  children [ Shape { appearance PBRAppearance { baseColor 0.45 0.45 0.5 } geometry Box { size 16 0.1 5 } } ]
  locked TRUE
}
DEF RIGHT_WALL Solid {
  translation 0 -3.05 2.5
  children [ Shape { appearance PBRAppearance { baseColor 0.45 0.45 0.5 } geometry Box { size 16 0.1 5 } } ]
  locked TRUE
}
DEF POLE Solid {
  translation 2.2 -0.5 2.5
  children [ Shape { appearance PBRAppearance { baseColor 0.35 0.35 0.4 } geometry Cylinder { radius 0.15 height 5 } } ]
  locked TRUE
}
DEF OCCLUDER Solid {
  translation 1.2 0.9 1.1
  children [ Shape { appearance PBRAppearance { baseColor 0.75 0.3 0.2 } geometry Box { size 0.06 0.6 0.9 } } ]
  locked TRUE
}
DEF MARKER_LEFT_UP Solid {
  translation 2.7 0.9 2.3
  children [ Shape { appearance PBRAppearance { baseColor 0.9 0.1 0.1 } geometry Box { size 0.2 0.3 0.3 } } ]
  locked TRUE
}
DEF MARKER_RIGHT_DOWN Solid {
  translation 2.7 -0.9 0.9
  children [ Shape { appearance PBRAppearance { baseColor 0.1 0.1 0.9 } geometry Box { size 0.2 0.3 0.3 } } ]
  locked TRUE
}
